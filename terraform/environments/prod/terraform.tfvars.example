# Purpose: prod environment example inputs.
environment      = "prod"
region           = "eu-central-1"
project_name     = "omnichannel"
vpc_cidr         = "10.40.0.0/16"
cluster_version  = "1.30"
node_instance_types = ["t3.large"]
node_desired_size = 3
node_min_size     = 3
node_max_size     = 8
namespaces        = ["omnichannel", "monitoring", "ingress-nginx"]
